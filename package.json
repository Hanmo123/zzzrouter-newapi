{
  "name": "new-api",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "PORT=${DEV_API_PORT:-3002} go run -tags api_only .",
    "dev:web": "API_PROXY_TARGET=${API_PROXY_TARGET:-http://127.0.0.1:${DEV_API_PORT:-3002}} bun run --cwd web dev -- --port ${DEV_WEB_PORT:-3001}",
    "dev:docker": "docker compose -f docker-compose.dev.yml up -d",
    "dev:docker:rebuild": "docker compose -f docker-compose.dev.yml up -d --build new-api",
    "install:web": "bun install --cwd web --frozen-lockfile",
    "build": "bun run --sequential build:api build:web",
    "build:api": "go build -tags api_only -o bin/new-api .",
    "build:web": "bun run --cwd web build",
    "preview:web": "API_PROXY_TARGET=${API_PROXY_TARGET:-http://127.0.0.1:${DEV_API_PORT:-3002}} bun run --cwd web preview -- --port ${DEV_WEB_PORT:-3001}",
    "test:commands": "node --test scripts/__tests__/commands.test.mjs",
    "test:proxy": "bun run --cwd web test:proxy"
  }
}
